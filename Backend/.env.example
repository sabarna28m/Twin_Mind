# ──────────────────────────────────────────────────────────────
# TwinMind Backend — Environment Variables
# Copy this to .env and fill real values. NEVER commit .env.
# ──────────────────────────────────────────────────────────────

# Application
APP_NAME=TwinMind API
DEBUG=false

# Database — Supabase PostgreSQL
# Supabase Dashboard → Settings → Database → Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase — Supabase Dashboard → Settings → API
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_ANON_KEY=eyJ...
# JWT Secret — Supabase Dashboard → Settings → API → JWT Settings
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Security — generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-a-long-random-string

# CORS — JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","https://your-app.vercel.app"]

# Frontend URL — used in password-reset emails
FRONTEND_URL=http://localhost:5173

# AI / LLM APIs
GROQ_API_KEY=gsk_your_groq_key_here
GEMINI_API_KEY=AIza_your_gemini_key_here

# YouTube Data API v3
# Get a free key: https://console.cloud.google.com → APIs & Services → YouTube Data API v3
YOUTUBE_API_KEY=AIza_your_youtube_key_here

# Email (Gmail SMTP)
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM=you@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# Google OAuth (Calendar integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/calendar/callback

# Google reCAPTCHA (test key always passes — replace for production)
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMIksjbgpeBS8bJ8
